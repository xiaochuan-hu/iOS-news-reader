# Protect all /v1 endpoints. Use a long random value in production.
MORNING_API_TOKEN=change-me

MORNING_DATABASE_PATH=data/morning_intelligence.db
MORNING_SOURCES_CONFIG=config/sources.yaml
MORNING_PREFERENCES_CONFIG=config/preferences.yaml
MORNING_REFRESH_INTERVAL_MINUTES=20
MORNING_SOURCE_TIMEOUT_SECONDS=8
MORNING_LLM_TIMEOUT_SECONDS=20
MORNING_GENERATION_DEADLINE_SECONDS=25
MORNING_BACKGROUND_REFRESH_ENABLED=true

# Leave LLM_API_KEY empty for the fully deterministic fallback briefing.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
