# Protect all /v1 endpoints. Use a long random value in production.
MORNING_API_TOKEN=change-me

MORNING_DATABASE_PATH=data/morning_intelligence.db
MORNING_SOURCES_CONFIG=config/sources.yaml
MORNING_PREFERENCES_CONFIG=config/preferences.yaml
MORNING_SOURCE_TIMEOUT_SECONDS=8
MORNING_AUXILIARY_TIMEOUT_SECONDS=8
MORNING_LLM_TIMEOUT_SECONDS=60
MORNING_GENERATION_DEADLINE_SECONDS=90
# V3 production: the iPhone owns local-time scheduling. Legacy scheduler requires
# both MORNING_GENERATION_TRIGGER=server and MORNING_BACKGROUND_REFRESH_ENABLED=true.
MORNING_GENERATION_TRIGGER=client
MORNING_BACKGROUND_REFRESH_ENABLED=false
MORNING_MANUAL_GENERATION_ENABLED=false
MORNING_MIN_LLM_INTERVAL_HOURS=20
# Legacy/server-scheduled mode only:
MORNING_REFRESH_TIMEZONE=Europe/London
MORNING_REFRESH_TIME_LOCAL=06:00

# DeepSeek production example. Leave LLM_API_KEY empty for deterministic fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_MODE=disabled

# Other OpenAI-compatible providers can override URL/model and leave
# LLM_THINKING_MODE unset so the optional `thinking` field is not sent.
